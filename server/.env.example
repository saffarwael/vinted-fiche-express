OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
PORT=3001

# Authentification (compte unique)
AUTH_USERNAME=admin
# Génère cette valeur avec : node hash-password.js <ton-mot-de-passe>
AUTH_PASSWORD_HASH=
# Génère cette valeur avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Passe à true en production, derrière HTTPS
COOKIE_SECURE=false

# Stockage des fiches enregistrées (Supabase)
# Project Settings > API dans ton projet Supabase
SUPABASE_URL=https://xxxxxxxx.supabase.co
# La clé "service_role" (pas "anon") — reste côté serveur uniquement
SUPABASE_KEY=
